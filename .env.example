# OceanEmbed — environment variables (copy to .env and fill in)
# .env is gitignored. Never commit real credentials.

# --- Optional: Copernicus Marine (sea surface height) ---
# Free account: https://data.marine.copernicus.eu/register
COPERNICUSMARINE_USERNAME=your_cmems_username
COPERNICUSMARINE_PASSWORD=your_cmems_password

# --- Optional: NASA Earthdata (SMAP sea surface salinity) ---
# Free account: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# Optional: force a shorter time range for quick runs, e.g. "2024-01-15"
# (overrides config.yaml time_range.start when present)
# OCEANEMBED_START_DATE=